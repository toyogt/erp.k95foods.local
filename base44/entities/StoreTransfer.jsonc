{
  "name": "StoreTransfer",
  "type": "object",
  "title": "Store Internal Transfer",
  "description": "Internal stock movement between locations",
  "properties": {
    "transfer_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "from_location_id": {
      "type": "string",
      "maxLength": 100
    },
    "from_location_code": {
      "type": "string",
      "maxLength": 100
    },
    "to_location_id": {
      "type": "string",
      "maxLength": 100
    },
    "to_location_code": {
      "type": "string",
      "maxLength": 100
    },
    "lot_id": {
      "type": "string",
      "maxLength": 100
    },
    "item_code": {
      "type": "string",
      "maxLength": 100
    },
    "item_name": {
      "type": "string",
      "maxLength": 300
    },
    "uom": {
      "type": "string",
      "maxLength": 50
    },
    "quantity": {
      "type": "number",
      "minimum": 0.01
    },
    "reason": {
      "type": "string",
      "maxLength": 500
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "cancelled"
      ],
      "default": "completed"
    },
    "transferred_by": {
      "type": "string",
      "maxLength": 200
    },
    "transferred_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "transfer_id",
    "from_location_id",
    "to_location_id",
    "lot_id",
    "quantity"
  ]
}