{
  "name": "ExecutiveMeetingPlan",
  "type": "object",
  "title": "Executive Meeting Plan",
  "description": "Weekly meeting planning per person \u2014 planned Green/Yellow/Red counts, remarks, and meeting status",
  "properties": {
    "person_email": {
      "type": "string",
      "maxLength": 200,
      "description": "Email of the person this plan is for"
    },
    "person_name": {
      "type": "string",
      "maxLength": 200
    },
    "week_start_date": {
      "type": "string",
      "maxLength": 20,
      "description": "Monday of the week DD/MM/YYYY"
    },
    "week_end_date": {
      "type": "string",
      "maxLength": 20,
      "description": "Sunday of the week DD/MM/YYYY"
    },
    "week_number": {
      "type": "number",
      "description": "ISO week number"
    },
    "year": {
      "type": "number",
      "description": "Year"
    },
    "this_week_planned_green": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "this_week_planned_yellow": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "this_week_planned_red": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "next_week_planned_green": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "next_week_planned_yellow": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "next_week_planned_red": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "meeting_remarks": {
      "type": "string",
      "maxLength": 5000
    },
    "meeting_done": {
      "type": "boolean",
      "default": false,
      "description": "Whether the meeting for this person for this week has been completed"
    },
    "updated_by_email": {
      "type": "string",
      "maxLength": 200
    },
    "updated_by_name": {
      "type": "string",
      "maxLength": 200
    }
  },
  "required": [
    "person_email",
    "week_start_date"
  ]
}