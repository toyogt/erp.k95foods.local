{
  "name": "LblPrintCommand",
  "type": "object",
  "title": "Labelling Print Command",
  "properties": {
    "command_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "job_id": {
      "type": "string",
      "maxLength": 50
    },
    "middleware_job_id": {
      "type": "string",
      "maxLength": 100,
      "description": "Job ID returned by Rynan middleware after command acknowledgement"
    },
    "printer_id": {
      "type": "string",
      "maxLength": 50
    },
    "endpoint_url": {
      "type": "string",
      "maxLength": 500
    },
    "command_type": {
      "type": "string",
      "enum": [
        "demo",
        "bulk_start",
        "bulk_stop",
        "bulk_resume",
        "test_ping"
      ],
      "description": "Type of print command"
    },
    "quantity": {
      "type": "number",
      "minimum": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "sent",
        "acknowledged",
        "completed",
        "failed"
      ],
      "default": "queued"
    },
    "request_payload": {
      "type": "object",
      "description": "Exact payload sent to middleware"
    },
    "response_payload": {
      "type": "object",
      "description": "Response from middleware"
    },
    "response_status_code": {
      "type": "number",
      "description": "HTTP status code from middleware"
    },
    "error_message": {
      "type": "string",
      "maxLength": 1000
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "sent_by": {
      "type": "string",
      "maxLength": 200
    }
  },
  "required": [
    "command_id",
    "job_id",
    "command_type"
  ]
}