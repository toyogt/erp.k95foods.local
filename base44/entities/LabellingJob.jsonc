{
  "name": "LabellingJob",
  "type": "object",
  "title": "Labelling Job",
  "properties": {
    "job_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "plan_id": {
      "type": "string",
      "maxLength": 50,
      "description": "Reference to LabellingShiftPlan"
    },
    "sku_code": {
      "type": "string",
      "maxLength": 100,
      "description": "Product/SKU code from ProductMaster"
    },
    "product_name": {
      "type": "string",
      "maxLength": 300
    },
    "bottle_type": {
      "type": "string",
      "maxLength": 100
    },
    "mrp": {
      "type": "string",
      "maxLength": 50
    },
    "manufacturing_date": {
      "type": "string",
      "maxLength": 20,
      "description": "Manufacturing date DD/MM/YYYY"
    },
    "labelling_date": {
      "type": "string",
      "maxLength": 20,
      "description": "Actual labelling start date DD/MM/YYYY \u2014 set at stock transfer step"
    },
    "batch_no": {
      "type": "string",
      "maxLength": 100,
      "description": "Generated batch number for this labelling run"
    },
    "batch_seq": {
      "type": "number",
      "minimum": 1,
      "default": 1,
      "description": "Sequence number used in batch generation (for day_year_seq scheme)"
    },
    "batch_prefix_code": {
      "type": "string",
      "maxLength": 20,
      "description": "Product prefix code used in batch number (copied from ProductMaster.product_prefix_code)"
    },
    "flavour_code": {
      "type": "string",
      "maxLength": 10,
      "description": "Flavour abbreviation used in batch number (copied from ProductMaster.flavour_code)"
    },
    "batch_scheme": {
      "type": "string",
      "enum": [
        "excel_date",
        "day_year_seq"
      ],
      "default": "excel_date",
      "description": "Batch generation scheme"
    },
    "printer_template_id": {
      "type": "string",
      "maxLength": 100,
      "description": "Selected LblPrintTemplate ID for this job's label printing"
    },
    "quantity_bottles_planned": {
      "type": "number",
      "minimum": 0
    },
    "quantity_cases_planned": {
      "type": "number",
      "minimum": 0
    },
    "priority_order": {
      "type": "number",
      "minimum": 1,
      "description": "Execution order on line \u2014 lower = higher priority"
    },
    "line_id": {
      "type": "string",
      "maxLength": 100
    },
    "line_name": {
      "type": "string",
      "maxLength": 200
    },
    "shift_type": {
      "type": "string",
      "enum": [
        "day",
        "night"
      ]
    },
    "plan_date": {
      "type": "string",
      "maxLength": 20
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "stock_transferred",
        "demo_print_sent",
        "demo_print_verified",
        "checklist_submitted",
        "demo_pending_approval",
        "demo_approved",
        "demo_rejected",
        "bulk_printing",
        "paused",
        "bulk_printing_awaiting_printer_reset",
        "completed",
        "cancelled"
      ],
      "default": "pending"
    },
    "stock_transfer_qty": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "stock_transfer_batch": {
      "type": "string",
      "maxLength": 100
    },
    "stock_transfer_remarks": {
      "type": "string",
      "maxLength": 500
    },
    "demo_print_qty": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "demo_image_url": {
      "type": "string",
      "maxLength": 1000
    },
    "demo_print_command_id": {
      "type": "string",
      "maxLength": 50,
      "description": "Command ID of the demo print command sent to middleware"
    },
    "demo_print_middleware_job_id": {
      "type": "string",
      "maxLength": 100,
      "description": "Job ID returned by middleware for demo print"
    },
    "demo_print_verified_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when demo print was physically verified by operator"
    },
    "demo_print_verified_by": {
      "type": "string",
      "maxLength": 200,
      "description": "Email of operator who verified demo print"
    },
    "current_printed_qty": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "accepted_qty": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "rejected_qty": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "wastage_qty": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "completion_remarks": {
      "type": "string",
      "maxLength": 1000
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "started_by": {
      "type": "string",
      "maxLength": 200
    },
    "completed_by": {
      "type": "string",
      "maxLength": 200
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "not_required",
        "pending",
        "approved",
        "rejected"
      ],
      "default": "not_required"
    },
    "approved_by": {
      "type": "string",
      "maxLength": 200
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "rejection_reason": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "job_id",
    "plan_id",
    "sku_code",
    "product_name",
    "quantity_bottles_planned",
    "priority_order"
  ]
}