{
  "name": "RecipeOption",
  "type": "object",
  "title": "Recipe Option",
  "properties": {
    "option_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50,
      "description": "Unique option identifier (auto-generated, e.g. OPT-xxxxx)"
    },
    "recipe_group_id": {
      "type": "string",
      "maxLength": 50,
      "description": "Reference to RecipeGroup.recipe_group_id"
    },
    "option_name": {
      "type": "string",
      "maxLength": 50,
      "description": "e.g. PRIMARY, FALLBACK_1, FALLBACK_2"
    },
    "is_default": {
      "type": "boolean",
      "default": false,
      "description": "Only one option per group can be default"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "option_id",
    "recipe_group_id",
    "option_name"
  ]
}