{
  "name": "MachineActiveBatch",
  "type": "object",
  "title": "Machine Active Batch",
  "properties": {
    "machine_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "batch_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "product_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "bottle_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "CLOSED"
      ],
      "default": "ACTIVE"
    },
    "assigned_by": {
      "type": "string",
      "maxLength": 200
    },
    "assigned_at": {
      "type": "string",
      "format": "date-time"
    },
    "closed_by": {
      "type": "string",
      "maxLength": 200
    },
    "closed_at": {
      "type": "string",
      "format": "date-time"
    },
    "change_reason": {
      "type": "string",
      "maxLength": 500
    },
    "expected_crates": {
      "type": "number",
      "minimum": 0
    },
    "created_crates": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "palletized_crates": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "close_policy": {
      "type": "string",
      "enum": [
        "ALLOW_CLOSE_ANYTIME",
        "REQUIRE_PALLETIZED",
        "REQUIRE_TRANSFERRED"
      ],
      "default": "REQUIRE_PALLETIZED"
    },
    "close_override_reason": {
      "type": "string",
      "maxLength": 500
    }
  },
  "required": [
    "machine_id",
    "batch_id",
    "product_code",
    "bottle_type"
  ]
}