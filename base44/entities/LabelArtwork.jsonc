{
  "name": "LabelArtwork",
  "type": "object",
  "title": "Label Artwork",
  "properties": {
    "artwork_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Unique artwork identifier (auto-generated, e.g. ART-xxxxx)"
    },
    "artwork_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Display name for this artwork"
    },
    "artwork_version": {
      "type": "string",
      "maxLength": 50,
      "description": "e.g. v1.0, v2.1"
    },
    "label_size": {
      "type": "string",
      "maxLength": 50,
      "description": "Label dimensions, e.g. 90mm x 60mm"
    },
    "preview_url": {
      "type": "string",
      "maxLength": 500,
      "description": "URL to artwork preview image"
    },
    "open_file_url": {
      "type": "string",
      "maxLength": 500,
      "description": "URL to editable design file (AI, PSD, etc.)"
    },
    "approved_file_url": {
      "type": "string",
      "maxLength": 500,
      "description": "URL to print-ready approved file (PDF, etc.)"
    },
    "nutritional_facts": {
      "type": "object",
      "description": "Structured nutritional information as JSON, e.g. {\"energy\": \"100 kcal\", \"protein\": \"5g\", \"carbohydrates\": \"10g\", \"fat\": \"2g\"}"
    },
    "ingredient_list": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Structured ingredient list as JSON array, e.g. [{\"name\": \"Water\", \"percentage\": \"60%\"}, {\"name\": \"Sugar\", \"allergen\": true}]"
    },
    "manufacturer_id": {
      "type": "string",
      "maxLength": 100,
      "description": "Reference to ManufacturerMaster.manufacturer_id"
    },
    "net_quantity_format": {
      "type": "string",
      "maxLength": 100,
      "description": "Format string for net quantity, e.g. '500 ml', '{volume} ml'"
    },
    "expiry_format": {
      "type": "string",
      "maxLength": 200,
      "description": "Format string for expiry display, e.g. 'Best before: {months} months from MFG'"
    },
    "note_text": {
      "type": "string",
      "maxLength": 500,
      "description": "Custom note for the label, e.g., 'See bottles for individual mfg date and batch no.'"
    },
    "mrp_display_format": {
      "type": "string",
      "maxLength": 200,
      "description": "Format string for MRP display, e.g., 'MRP: \u20b9{mrp}'"
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "PENDING_APPROVAL",
        "APPROVED",
        "ARCHIVED"
      ],
      "default": "DRAFT",
      "description": "Current approval status of the artwork"
    },
    "approved_by": {
      "type": "string",
      "maxLength": 200,
      "description": "Email of user who approved this artwork"
    },
    "approved_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date when artwork was approved"
    },
    "version_notes": {
      "type": "string",
      "maxLength": 1000,
      "description": "Notes about this version/changes made"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "notes": {
      "type": "string",
      "maxLength": 500
    }
  },
  "required": [
    "artwork_id",
    "artwork_name"
  ]
}