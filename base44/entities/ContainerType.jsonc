{
  "name": "ContainerType",
  "type": "object",
  "title": "Container Type",
  "properties": {
    "container_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Unique SKU code for the container"
    },
    "auto_generated_name": {
      "type": "string",
      "maxLength": 200,
      "description": "Auto-generated name based on container details"
    },
    "container_type": {
      "type": "string",
      "enum": [
        "Glass Bottle",
        "Can"
      ],
      "description": "Type of container"
    },
    "ml_per_container": {
      "type": "number",
      "minimum": 1,
      "description": "Volume in milliliters per container"
    },
    "colour": {
      "type": "string",
      "enum": [
        "Transparent",
        "Amber"
      ],
      "description": "Container colour"
    },
    "vendor_nickname": {
      "type": "string",
      "maxLength": 200,
      "description": "Vendor/Nick name to identify the container"
    },
    "bottles_per_crate": {
      "type": "number",
      "minimum": 1
    },
    "datasheet_url": {
      "type": "string",
      "maxLength": 500,
      "description": "URL to container data sheet document"
    }
  },
  "required": [
    "container_code",
    "auto_generated_name",
    "container_type",
    "ml_per_container",
    "colour",
    "vendor_nickname",
    "bottles_per_crate"
  ]
}