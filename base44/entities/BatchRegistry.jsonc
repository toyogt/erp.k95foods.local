{
  "name": "BatchRegistry",
  "type": "object",
  "title": "Batch Registry",
  "properties": {
    "batch_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50,
      "description": "Full batch ID generated by the rule"
    },
    "unique_id": {
      "type": "string",
      "maxLength": 6,
      "minLength": 6,
      "description": "6-digit globally unique identifier (100000-999999)"
    },
    "product_code": {
      "type": "string",
      "maxLength": 100,
      "description": "SKU item code"
    },
    "product_name": {
      "type": "string",
      "maxLength": 200
    },
    "brand_name": {
      "type": "string",
      "maxLength": 200
    },
    "product_family": {
      "type": "string",
      "maxLength": 200
    },
    "flavour": {
      "type": "string",
      "maxLength": 100
    },
    "batch_date": {
      "type": "string",
      "format": "date-time",
      "description": "Manufacturing or labelling date used for batch generation"
    },
    "batch_date_source": {
      "type": "string",
      "enum": [
        "MFG_START",
        "LABEL_START"
      ],
      "description": "Which date type was used"
    },
    "batch_format_rule_id": {
      "type": "string",
      "maxLength": 100,
      "description": "Rule used to generate this batch"
    },
    "sequence_number": {
      "type": "number",
      "minimum": 1,
      "description": "Sequence number within the reset scope"
    },
    "reset_scope": {
      "type": "string",
      "enum": [
        "DAILY",
        "MONTHLY",
        "YEARLY",
        "NEVER"
      ]
    },
    "created_location": {
      "type": "string",
      "maxLength": 100,
      "description": "Station/location where batch was created"
    },
    "created_by_user": {
      "type": "string",
      "maxLength": 200
    },
    "metadata": {
      "type": "object",
      "description": "Additional context (MRP, bottle type, etc.)"
    }
  },
  "required": [
    "batch_id",
    "unique_id",
    "product_code"
  ]
}