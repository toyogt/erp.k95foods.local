{
  "name": "Customer",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Customer Name"
    },
    "code": {
      "type": "string",
      "title": "Customer Code"
    },
    "series": {
      "type": "string",
      "title": "Series"
    },
    "customer_type": {
      "type": "string",
      "title": "Customer Type",
      "enum": [
        "Company",
        "Individual"
      ]
    },
    "customer_group": {
      "type": "string",
      "title": "Customer Group"
    },
    "salutation": {
      "type": "string",
      "title": "Salutation",
      "enum": [
        "Mr",
        "Ms",
        "Mrs",
        "Dr",
        "Prof"
      ]
    },
    "first_name": {
      "type": "string",
      "title": "First Name"
    },
    "last_name": {
      "type": "string",
      "title": "Last Name"
    },
    "gender": {
      "type": "string",
      "title": "Gender",
      "enum": [
        "Male",
        "Female",
        "Other"
      ]
    },
    "contact_name": {
      "type": "string",
      "title": "Contact Name"
    },
    "mobile_no": {
      "type": "string",
      "title": "Mobile Number"
    },
    "phone": {
      "type": "string",
      "title": "Phone"
    },
    "email": {
      "type": "string",
      "title": "Email ID"
    },
    "website": {
      "type": "string",
      "title": "Website"
    },
    "image": {
      "type": "string",
      "title": "Image URL"
    },
    "from_lead": {
      "type": "string",
      "title": "From Lead"
    },
    "from_opportunity": {
      "type": "string",
      "title": "From Opportunity"
    },
    "from_prospect": {
      "type": "string",
      "title": "From Prospect"
    },
    "represents_company": {
      "type": "boolean",
      "title": "Represents Company",
      "default": false
    },
    "gstin": {
      "type": "string",
      "title": "GSTIN / UIN"
    },
    "pan": {
      "type": "string",
      "title": "PAN"
    },
    "tax_id": {
      "type": "string",
      "title": "Tax ID"
    },
    "gst_category": {
      "type": "string",
      "title": "GST Category",
      "enum": [
        "Registered Regular",
        "Registered Composition",
        "Unregistered",
        "SEZ",
        "Overseas",
        "UIN Holders"
      ]
    },
    "tax_category": {
      "type": "string",
      "title": "Tax Category"
    },
    "tax_withholding_category": {
      "type": "string",
      "title": "Tax Withholding Category"
    },
    "billing_address": {
      "type": "string",
      "title": "Billing Address"
    },
    "shipping_address": {
      "type": "string",
      "title": "Shipping Address"
    },
    "primary_address": {
      "type": "string",
      "title": "Primary Address"
    },
    "customer_primary_address": {
      "type": "string",
      "title": "Customer Primary Address"
    },
    "customer_primary_contact": {
      "type": "string",
      "title": "Customer Primary Contact"
    },
    "region": {
      "type": "string",
      "title": "Region / Territory"
    },
    "territory": {
      "type": "string",
      "title": "Territory"
    },
    "outlet_id": {
      "type": "string",
      "title": "Outlet ID"
    },
    "customer_pos_id": {
      "type": "string",
      "title": "Customer POS ID"
    },
    "place_of_supply": {
      "type": "string",
      "title": "Place of Supply (State Code)"
    },
    "market_segment": {
      "type": "string",
      "title": "Market Segment"
    },
    "industry": {
      "type": "string",
      "title": "Industry"
    },
    "account_manager": {
      "type": "string",
      "title": "Account Manager"
    },
    "sales_partner": {
      "type": "string",
      "title": "Sales Partner"
    },
    "commission_rate": {
      "type": "number",
      "title": "Commission Rate (%)"
    },
    "payment_terms": {
      "type": "string",
      "title": "Default Payment Terms"
    },
    "price_list": {
      "type": "string",
      "title": "Default Price List"
    },
    "billing_currency": {
      "type": "string",
      "title": "Billing Currency",
      "default": "INR"
    },
    "default_bank_account": {
      "type": "string",
      "title": "Default Company Bank Account"
    },
    "loyalty_program": {
      "type": "string",
      "title": "Loyalty Program"
    },
    "loyalty_program_tier": {
      "type": "string",
      "title": "Loyalty Program Tier"
    },
    "print_language": {
      "type": "string",
      "title": "Print Language"
    },
    "customer_details": {
      "type": "string",
      "title": "Customer Details"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "suspended"
      ],
      "title": "Status"
    },
    "check_outstanding": {
      "type": "boolean",
      "title": "Check Credit Outstanding",
      "default": false
    },
    "outstanding_limit": {
      "type": "number",
      "title": "Outstanding Credit Limit (INR)"
    },
    "leverage_outstanding": {
      "type": "number",
      "title": "Leverage on Credit Limit (INR)",
      "default": 0
    },
    "current_outstanding": {
      "type": "number",
      "title": "Current Outstanding (INR)",
      "default": 0
    },
    "bypass_credit_limit_check": {
      "type": "boolean",
      "title": "Bypass Credit Limit Check at Sales Order",
      "default": false
    },
    "is_internal_customer": {
      "type": "boolean",
      "title": "Is Internal Customer",
      "default": false
    },
    "allow_invoice_without_so": {
      "type": "boolean",
      "title": "Allow Invoice Creation Without Sales Order",
      "default": false
    },
    "allow_invoice_without_dn": {
      "type": "boolean",
      "title": "Allow Invoice Creation Without Delivery Note",
      "default": false
    },
    "is_frozen": {
      "type": "boolean",
      "title": "Is Frozen",
      "default": false
    },
    "disabled": {
      "type": "boolean",
      "title": "Disabled",
      "default": false
    },
    "tally_synced": {
      "type": "boolean",
      "title": "Tally Synced",
      "default": false
    },
    "tally_sync_date": {
      "type": "string",
      "title": "Tally Sync Date"
    },
    "tally_sync_status": {
      "type": "string",
      "title": "Tally Sync Status"
    },
    "tally_parent_group": {
      "type": "string",
      "title": "Tally Parent Group"
    },
    "notes": {
      "type": "string",
      "title": "Internal Notes"
    },
    "workflow_state": {
      "type": "string",
      "title": "Workflow State"
    },
    "sales_team": {
      "type": "array",
      "title": "Sales Team",
      "items": {
        "type": "object",
        "properties": {
          "sales_person": {
            "type": "string"
          },
          "commission_rate": {
            "type": "number"
          },
          "contact_no": {
            "type": "string"
          },
          "contribution_pct": {
            "type": "number",
            "description": "Contribution (%)"
          },
          "contribution_to_net_total": {
            "type": "number"
          },
          "incentives": {
            "type": "number"
          }
        }
      }
    },
    "allowed_to_transact_with": {
      "type": "array",
      "title": "Allowed To Transact With",
      "items": {
        "type": "object",
        "properties": {
          "company": {
            "type": "string"
          }
        }
      }
    },
    "credit_limits": {
      "type": "array",
      "title": "Credit Limits",
      "items": {
        "type": "object",
        "properties": {
          "company": {
            "type": "string"
          },
          "credit_limit": {
            "type": "number"
          },
          "bypass_credit_limit_check": {
            "type": "boolean"
          }
        }
      }
    },
    "accounts": {
      "type": "array",
      "title": "Accounts",
      "items": {
        "type": "object",
        "properties": {
          "company": {
            "type": "string"
          },
          "advance_account": {
            "type": "string"
          },
          "default_account": {
            "type": "string"
          }
        }
      }
    },
    "portal_users": {
      "type": "array",
      "title": "Customer Portal Users",
      "items": {
        "type": "object",
        "properties": {
          "user": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "name",
    "status"
  ]
}