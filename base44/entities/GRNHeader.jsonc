{
  "name": "GRNHeader",
  "type": "object",
  "title": "GRN Header",
  "properties": {
    "grn_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "gate_id": {
      "type": "string",
      "maxLength": 50
    },
    "supplier_id": {
      "type": "string",
      "maxLength": 50
    },
    "supplier_name": {
      "type": "string",
      "maxLength": 200
    },
    "invoice_number": {
      "type": "string",
      "maxLength": 100,
      "description": "Supplier invoice number"
    },
    "invoice_date": {
      "type": "string",
      "format": "date",
      "description": "Supplier invoice date"
    },
    "po_id": {
      "type": "string",
      "maxLength": 50
    },
    "linked_po_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of linked PO IDs for multi-PO GRNs"
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "RECEIVED",
        "SUBMITTED_TO_QC",
        "QC_HOLD",
        "QC_PASSED",
        "QC_FAILED",
        "CANCELLED"
      ],
      "default": "DRAFT"
    },
    "received_at": {
      "type": "string",
      "format": "date-time"
    },
    "received_by": {
      "type": "string",
      "maxLength": 200
    },
    "notes": {
      "type": "string",
      "maxLength": 2000
    },
    "checklist_run_id": {
      "type": "string",
      "maxLength": 100
    },
    "erp_sync_status": {
      "type": "string",
      "enum": [
        "NOT_SYNCED",
        "QUEUED",
        "SYNCED",
        "FAILED"
      ],
      "default": "NOT_SYNCED"
    },
    "erp_name": {
      "type": "string",
      "maxLength": 100
    },
    "freight_amount": {
      "type": "number",
      "minimum": 0,
      "description": "Actual freight cost for this GRN shipment"
    },
    "freight_notes": {
      "type": "string",
      "maxLength": 500,
      "description": "Freight notes or transporter details"
    }
  },
  "required": [
    "grn_id"
  ]
}