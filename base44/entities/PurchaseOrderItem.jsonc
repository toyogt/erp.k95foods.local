{
  "name": "PurchaseOrderItem",
  "type": "object",
  "title": "Purchase Order Item",
  "properties": {
    "po_id": {
      "type": "string",
      "maxLength": 50
    },
    "item_code": {
      "type": "string",
      "maxLength": 100
    },
    "item_name": {
      "type": "string",
      "maxLength": 200
    },
    "uom_code": {
      "type": "string",
      "maxLength": 50
    },
    "qty": {
      "type": "number",
      "minimum": 0
    },
    "rate": {
      "type": "number",
      "minimum": 0
    },
    "amount": {
      "type": "number",
      "minimum": 0
    },
    "schedule_date": {
      "type": "string",
      "format": "date"
    },
    "warehouse_code": {
      "type": "string",
      "maxLength": 100
    },
    "remarks": {
      "type": "string",
      "maxLength": 500
    }
  },
  "required": [
    "po_id",
    "item_code",
    "qty"
  ]
}