{
  "name": "FMSEscalationLog",
  "type": "object",
  "title": "FMS Escalation Log",
  "properties": {
    "instance_id": {
      "type": "string",
      "maxLength": 100
    },
    "step_instance_id": {
      "type": "string",
      "maxLength": 100
    },
    "step_name": {
      "type": "string",
      "maxLength": 200
    },
    "process_name": {
      "type": "string",
      "maxLength": 200
    },
    "action_type": {
      "type": "string",
      "enum": [
        "reminder",
        "escalation",
        "reassignment",
        "note",
        "auto_reminder"
      ],
      "default": "reminder"
    },
    "performed_by": {
      "type": "string",
      "maxLength": 200
    },
    "target_email": {
      "type": "string",
      "maxLength": 200
    },
    "message": {
      "type": "string",
      "maxLength": 1000
    },
    "performed_at": {
      "type": "string",
      "format": "date-time"
    },
    "from_assignee": {
      "type": "string",
      "maxLength": 200
    },
    "to_assignee": {
      "type": "string",
      "maxLength": 200
    }
  },
  "required": [
    "instance_id",
    "action_type"
  ]
}