{
  "name": "WarehouseDispatchLine",
  "type": "object",
  "title": "Warehouse Dispatch Line",
  "properties": {
    "dispatch_id": {
      "type": "string",
      "maxLength": 50
    },
    "lot_id": {
      "type": "string",
      "maxLength": 50
    },
    "sku_code": {
      "type": "string",
      "maxLength": 100
    },
    "product_name": {
      "type": "string",
      "maxLength": 200
    },
    "boxes_dispatched": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "loose_bottles_dispatched": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "bottles_per_box": {
      "type": "number",
      "minimum": 1
    },
    "total_bottles": {
      "type": "number",
      "minimum": 0,
      "default": 0
    }
  },
  "required": [
    "dispatch_id",
    "sku_code"
  ]
}