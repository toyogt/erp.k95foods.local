{
  "name": "StoreIssueLine",
  "type": "object",
  "title": "Store Issue Line",
  "description": "Individual item lines for a stock issue with batch traceability",
  "properties": {
    "issue_id": {
      "type": "string",
      "maxLength": 100
    },
    "lot_id": {
      "type": "string",
      "maxLength": 100
    },
    "location_id": {
      "type": "string",
      "maxLength": 100
    },
    "location_code": {
      "type": "string",
      "maxLength": 100
    },
    "item_code": {
      "type": "string",
      "maxLength": 100
    },
    "item_name": {
      "type": "string",
      "maxLength": 300
    },
    "uom": {
      "type": "string",
      "maxLength": 50
    },
    "batch_number": {
      "type": "string",
      "maxLength": 200,
      "description": "Batch number from the lot"
    },
    "manufacturing_date": {
      "type": "string",
      "maxLength": 20,
      "description": "Manufacturing date of the issued lot"
    },
    "expiry_date": {
      "type": "string",
      "maxLength": 20,
      "description": "Expiry date of the issued lot"
    },
    "supplier_name": {
      "type": "string",
      "maxLength": 300,
      "description": "Supplier from the original lot"
    },
    "requested_quantity": {
      "type": "number",
      "minimum": 0
    },
    "issued_quantity": {
      "type": "number",
      "minimum": 0
    },
    "issue_type": {
      "type": "string",
      "maxLength": 50
    },
    "picking_strategy": {
      "type": "string",
      "enum": [
        "FEFO",
        "FIFO",
        "manual"
      ],
      "default": "FEFO",
      "description": "Strategy used to select this lot"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "issue_id",
    "lot_id",
    "issued_quantity"
  ]
}