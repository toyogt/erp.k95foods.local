{
  "name": "Supplier",
  "type": "object",
  "title": "Supplier",
  "properties": {
    "supplier_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "supplier_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "APPROVED",
        "HOLD",
        "BLOCKED"
      ],
      "default": "HOLD"
    },
    "is_approved": {
      "type": "boolean",
      "default": false
    },
    "gstin": {
      "type": "string",
      "maxLength": 20
    },
    "payment_terms_days": {
      "type": "number",
      "minimum": 0
    },
    "default_currency": {
      "type": "string",
      "maxLength": 10,
      "default": "INR"
    },
    "contact_name": {
      "type": "string",
      "maxLength": 200
    },
    "phone": {
      "type": "string",
      "maxLength": 30
    },
    "email": {
      "type": "string",
      "maxLength": 200
    },
    "address": {
      "type": "string",
      "maxLength": 1000
    },
    "bank_details": {
      "type": "string",
      "maxLength": 1000
    },
    "notes": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "supplier_id",
    "supplier_name"
  ]
}