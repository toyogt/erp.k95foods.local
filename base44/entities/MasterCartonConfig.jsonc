{
  "name": "MasterCartonConfig",
  "type": "object",
  "title": "Master Carton Configuration",
  "properties": {
    "box_sku": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "carton_size": {
      "type": "number",
      "minimum": 1,
      "description": "Number of boxes per master carton"
    },
    "label_template_id": {
      "type": "string",
      "maxLength": 100,
      "description": "Ryan printer template ID"
    },
    "print_variables": {
      "type": "object",
      "description": "Dynamic label field mapping"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "box_sku",
    "carton_size"
  ]
}