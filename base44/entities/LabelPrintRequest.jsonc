{
  "name": "LabelPrintRequest",
  "type": "object",
  "title": "Label Print Request",
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "item_code": {
      "type": "string",
      "maxLength": 100
    },
    "product_name": {
      "type": "string",
      "maxLength": 300
    },
    "batch_no": {
      "type": "string",
      "maxLength": 100
    },
    "mfg_date": {
      "type": "string",
      "format": "date"
    },
    "exp_date": {
      "type": "string",
      "format": "date"
    },
    "qty_labels": {
      "type": "number",
      "minimum": 1
    },
    "is_trial_pack": {
      "type": "boolean",
      "default": false
    },
    "contents_json": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "APPROVED",
        "REJECTED",
        "PRINTED"
      ],
      "default": "PENDING"
    },
    "requested_by": {
      "type": "string",
      "maxLength": 200
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "approved_by": {
      "type": "string",
      "maxLength": 200
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "decision_notes": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "request_id",
    "item_code",
    "batch_no",
    "qty_labels"
  ]
}