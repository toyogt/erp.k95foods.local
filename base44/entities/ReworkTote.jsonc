{
  "name": "ReworkTote",
  "type": "object",
  "title": "Rework Tote",
  "properties": {
    "tote_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "status": {
      "type": "string",
      "enum": [
        "OPEN",
        "CLOSED"
      ],
      "default": "OPEN"
    },
    "wo_id": {
      "type": "string",
      "maxLength": 50
    },
    "line_machine_id": {
      "type": "string",
      "maxLength": 50
    },
    "opened_at": {
      "type": "string",
      "format": "date-time"
    },
    "opened_by": {
      "type": "string",
      "maxLength": 200
    },
    "closed_at": {
      "type": "string",
      "format": "date-time"
    },
    "closed_by": {
      "type": "string",
      "maxLength": 200
    },
    "notes": {
      "type": "string",
      "maxLength": 1000
    },
    "estimated_labels_used_for_rework": {
      "type": "number",
      "minimum": 0
    }
  },
  "required": [
    "tote_id"
  ]
}