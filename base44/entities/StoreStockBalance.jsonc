{
  "name": "StoreStockBalance",
  "type": "object",
  "title": "Store Stock Balance",
  "description": "Current stock quantity at each location per lot",
  "properties": {
    "location_id": {
      "type": "string",
      "maxLength": 100
    },
    "location_code": {
      "type": "string",
      "maxLength": 100
    },
    "lot_id": {
      "type": "string",
      "maxLength": 100
    },
    "item_code": {
      "type": "string",
      "maxLength": 100
    },
    "item_name": {
      "type": "string",
      "maxLength": 300
    },
    "uom": {
      "type": "string",
      "maxLength": 50
    },
    "quantity": {
      "type": "number",
      "minimum": 0
    },
    "mfg_date": {
      "type": "string",
      "format": "date"
    },
    "expiry_date": {
      "type": "string",
      "format": "date"
    },
    "putaway_date": {
      "type": "string",
      "format": "date-time"
    },
    "putaway_by": {
      "type": "string",
      "maxLength": 200
    },
    "putaway_id": {
      "type": "string",
      "maxLength": 100
    }
  },
  "required": [
    "location_id",
    "lot_id",
    "item_code",
    "quantity"
  ]
}