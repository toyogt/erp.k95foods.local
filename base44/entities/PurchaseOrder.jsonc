{
  "name": "PurchaseOrder",
  "type": "object",
  "title": "Purchase Order",
  "properties": {
    "po_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "supplier_id": {
      "type": "string",
      "maxLength": 50
    },
    "supplier_name": {
      "type": "string",
      "maxLength": 200
    },
    "mr_id": {
      "type": "string",
      "maxLength": 50
    },
    "po_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "SUBMITTED",
        "APPROVED",
        "SENT",
        "PART_RECEIVED",
        "CLOSED",
        "CANCELLED"
      ],
      "default": "DRAFT"
    },
    "total_amount": {
      "type": "number",
      "minimum": 0
    },
    "currency": {
      "type": "string",
      "maxLength": 10,
      "default": "INR"
    },
    "terms": {
      "type": "string",
      "maxLength": 2000
    },
    "rejection_reason": {
      "type": "string",
      "maxLength": 500
    },
    "rejected_by": {
      "type": "string",
      "maxLength": 200
    },
    "rejected_at": {
      "type": "string",
      "format": "date-time"
    },
    "approved_by": {
      "type": "string",
      "maxLength": 200
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "sent_via": {
      "type": "string",
      "enum": [
        "WHATSAPP",
        "EMAIL"
      ],
      "maxLength": 20
    },
    "supplier_override_reason": {
      "type": "string",
      "maxLength": 500
    },
    "checklist_run_id": {
      "type": "string",
      "maxLength": 100
    },
    "erp_sync_status": {
      "type": "string",
      "enum": [
        "NOT_SYNCED",
        "QUEUED",
        "SYNCED",
        "FAILED"
      ],
      "default": "NOT_SYNCED"
    },
    "erp_name": {
      "type": "string",
      "maxLength": 100
    }
  },
  "required": [
    "po_id",
    "supplier_id",
    "po_date"
  ]
}