{
  "name": "RulesConfig",
  "type": "object",
  "title": "Business Rules Configuration",
  "description": "Configurable validation rules for transaction integrity",
  "properties": {
    "rule_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Unique machine key (e.g. DISPATCH_STOCK_CHECK, PALLET_APPROVAL_CHECK)"
    },
    "module": {
      "type": "string",
      "maxLength": 50,
      "description": "Module this rule applies to (WAREHOUSE, PRODUCTION, GRN, LABELLING, etc.)"
    },
    "entity_type": {
      "type": "string",
      "maxLength": 100,
      "description": "Entity being validated (Dispatch, Pallet, GRNItem, StockMovement, etc.)"
    },
    "action_type": {
      "type": "string",
      "maxLength": 50,
      "description": "Action being triggered (create, update, dispatch, receive, approve, print)"
    },
    "rule_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Human-readable rule name for UI"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "What this rule prevents"
    },
    "validation_type": {
      "type": "string",
      "enum": [
        "stock_availability",
        "status_requirement",
        "approval_requirement",
        "data_consistency",
        "lock_status",
        "reference_integrity",
        "tolerance_limit",
        "custom"
      ],
      "description": "Category of validation"
    },
    "conditions": {
      "type": "object",
      "description": "JSON object defining validation logic (field_path, operator, value)"
    },
    "error_message": {
      "type": "string",
      "maxLength": 500,
      "description": "User-friendly error message shown on block"
    },
    "allow_override": {
      "type": "boolean",
      "default": true,
      "description": "Can authorized users override this rule?"
    },
    "override_roles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Roles that can override (e.g. supervisor, manager)"
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Machine key (e.g. EMERGENCY, QUALITY_CHECK)"
          },
          "label": {
            "type": "string",
            "description": "Display label"
          }
        }
      },
      "description": "Valid override reason codes"
    },
    "severity": {
      "type": "string",
      "enum": [
        "warning",
        "block"
      ],
      "default": "block",
      "description": "Warning shows message but allows, Block prevents action"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 10
    }
  },
  "required": [
    "rule_key",
    "module",
    "entity_type",
    "action_type",
    "rule_name",
    "validation_type",
    "error_message"
  ]
}