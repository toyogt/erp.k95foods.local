{
  "name": "IngredientItem",
  "type": "object",
  "title": "Ingredient Brand Item",
  "properties": {
    "item_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50,
      "description": "Unique item identifier (auto-generated, e.g. ITM-00123)"
    },
    "ingredient_id": {
      "type": "string",
      "maxLength": 50,
      "description": "Reference to IngredientMaster.ingredient_id (the spec)"
    },
    "brand_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Brand or trade name of this ingredient source"
    },
    "supplier_name": {
      "type": "string",
      "maxLength": 200,
      "description": "Supplier / vendor name (optional)"
    },
    "status": {
      "type": "string",
      "enum": [
        "APPROVED",
        "HOLD",
        "BLOCKED"
      ],
      "default": "APPROVED",
      "description": "APPROVED=use freely, HOLD=under review, BLOCKED=do not use"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "notes": {
      "type": "string",
      "maxLength": 500
    }
  },
  "required": [
    "item_id",
    "ingredient_id",
    "brand_name"
  ]
}