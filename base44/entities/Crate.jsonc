{
  "name": "Crate",
  "type": "object",
  "title": "Crate",
  "properties": {
    "crate_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "bottle_type": {
      "type": "string",
      "maxLength": 100
    },
    "bottle_count": {
      "type": "number",
      "minimum": 0
    },
    "batch_id": {
      "type": "string",
      "maxLength": 50
    },
    "product_code": {
      "type": "string",
      "maxLength": 100
    },
    "filler_machine_id": {
      "type": "string",
      "maxLength": 50
    },
    "filled_time": {
      "type": "string",
      "format": "date-time"
    },
    "current_location": {
      "type": "string",
      "maxLength": 100
    },
    "status": {
      "type": "string",
      "enum": [
        "FILLED",
        "IN_CHAMBER",
        "POST_CHAMBER",
        "IN_TRANSIT",
        "RECEIVED_UNASSIGNED",
        "RECEIVED",
        "STORED",
        "CONSUMED",
        "EMPTY_RETURNED"
      ],
      "default": "FILLED"
    },
    "received_session_id": {
      "type": "string",
      "maxLength": 100
    },
    "crate_label_serial": {
      "type": "string",
      "maxLength": 100
    },
    "consumed_at": {
      "type": "string",
      "format": "date-time"
    },
    "consumed_by": {
      "type": "string",
      "maxLength": 200
    },
    "last_scan_time": {
      "type": "string",
      "format": "date-time"
    },
    "last_scanned_by": {
      "type": "string",
      "maxLength": 200
    }
  },
  "required": [
    "crate_id",
    "bottle_type",
    "bottle_count"
  ]
}