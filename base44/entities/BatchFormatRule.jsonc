{
  "name": "BatchFormatRule",
  "type": "object",
  "title": "Batch Format Rule",
  "properties": {
    "rule_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Unique rule identifier (auto-generated, e.g. BR-000123)"
    },
    "rule_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Human-readable rule name"
    },
    "description": {
      "type": "string",
      "maxLength": 500,
      "description": "Optional description / notes"
    },
    "batch_date_source": {
      "type": "string",
      "enum": [
        "MFG_START",
        "LABEL_START"
      ],
      "default": "MFG_START",
      "description": "Which date to use for batch code generation"
    },
    "reset_scope": {
      "type": "string",
      "enum": [
        "DAILY",
        "MONTHLY",
        "YEARLY",
        "NEVER"
      ],
      "default": "DAILY",
      "description": "When sequence counter resets"
    },
    "format_json": {
      "type": "string",
      "maxLength": 5000,
      "description": "JSON string of {reset_scope, parts[], month_codes{}, meta{}} generated by builder"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "notes": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "rule_id",
    "rule_name"
  ]
}