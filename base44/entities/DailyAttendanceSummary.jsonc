{
  "name": "DailyAttendanceSummary",
  "type": "object",
  "title": "Daily Attendance Summary",
  "description": "Computed daily attendance summary per employee. Generated by calculateDailyAttendance from AttendanceLog punches. One row per (employee_code, work_date).",
  "properties": {
    "employee_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50,
      "description": "Canonical employee code"
    },
    "employee_name": {
      "type": "string",
      "maxLength": 200,
      "description": "Employee name (resolved from Employee master if matched)"
    },
    "work_date": {
      "type": "string",
      "maxLength": 20,
      "description": "Work date in DD/MM/YYYY format"
    },
    "work_date_iso": {
      "type": "string",
      "format": "date",
      "description": "Work date in ISO YYYY-MM-DD format for sorting/filtering"
    },
    "first_in": {
      "type": "string",
      "format": "date-time",
      "description": "First IN punch of the day (UTC ISO timestamp)"
    },
    "last_out": {
      "type": "string",
      "format": "date-time",
      "description": "Last OUT punch of the day (UTC ISO timestamp)"
    },
    "total_work_minutes": {
      "type": "number",
      "minimum": 0,
      "default": 0,
      "description": "Total worked time in minutes (sum of paired IN/OUT durations, after break deduction)"
    },
    "total_work_hours": {
      "type": "number",
      "minimum": 0,
      "default": 0,
      "description": "Total worked time in hours (decimal, e.g. 8.5)"
    },
    "gross_span_minutes": {
      "type": "number",
      "minimum": 0,
      "default": 0,
      "description": "Gross span in minutes (last_out - first_in), useful as a sanity reference"
    },
    "punch_count": {
      "type": "number",
      "minimum": 0,
      "default": 0,
      "description": "Total number of punches on this day"
    },
    "in_count": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "out_count": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "pairs": {
      "type": "array",
      "description": "Resolved IN/OUT pairs with duration",
      "items": {
        "type": "object",
        "properties": {
          "in_time": {
            "type": "string",
            "format": "date-time"
          },
          "out_time": {
            "type": "string",
            "format": "date-time"
          },
          "duration_minutes": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "unmatched_punches": {
      "type": "array",
      "description": "Punches that could not be paired (orphan IN or orphan OUT). Used for HR review.",
      "items": {
        "type": "object",
        "properties": {
          "log_datetime": {
            "type": "string",
            "format": "date-time"
          },
          "punch_direction": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "CLEAN",
        "FLAGGED",
        "MISSING_OUT",
        "MISSING_IN",
        "NO_PUNCHES",
        "HOLIDAY",
        "HOLIDAY_WORKED"
      ],
      "default": "CLEAN",
      "description": "CLEAN = all punches paired; FLAGGED = has unmatched punches; MISSING_OUT/IN = day has only IN or only OUT punches; HOLIDAY = registered holiday with no punches; HOLIDAY_WORKED = registered holiday but employee punched in"
    },
    "shift_name_applied": {
      "type": "string",
      "maxLength": 100,
      "description": "Name of the shift used for late/overtime calculation"
    },
    "is_holiday": {
      "type": "boolean",
      "default": false,
      "description": "True if work_date is a registered holiday"
    },
    "holiday_name": {
      "type": "string",
      "maxLength": 200
    },
    "is_late_arrival": {
      "type": "boolean",
      "default": false
    },
    "is_early_departure": {
      "type": "boolean",
      "default": false
    },
    "late_arrival_minutes": {
      "type": "number",
      "minimum": 0,
      "default": 0,
      "description": "Minutes late beyond shift start + grace"
    },
    "early_departure_minutes": {
      "type": "number",
      "minimum": 0,
      "default": 0,
      "description": "Minutes left early before shift end - grace"
    },
    "overtime_minutes": {
      "type": "number",
      "minimum": 0,
      "default": 0,
      "description": "Minutes worked beyond shift end + overtime threshold"
    },
    "expected_work_minutes": {
      "type": "number",
      "minimum": 0,
      "default": 0,
      "description": "Shift's expected work duration in minutes (end - start - break)"
    },
    "deducted_break_minutes": {
      "type": "number",
      "minimum": 0,
      "default": 0,
      "description": "Break minutes deducted from gross worked time"
    },
    "calculation_method": {
      "type": "string",
      "enum": [
        "simple_pairing",
        "first_in_last_out"
      ],
      "default": "simple_pairing"
    },
    "calculated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this summary was last computed"
    },
    "manual_override": {
      "type": "boolean",
      "default": false,
      "description": "True if HR manually edited this record (recalculation will not overwrite)"
    },
    "remarks": {
      "type": "string",
      "maxLength": 500
    }
  },
  "required": [
    "employee_code",
    "work_date"
  ]
}