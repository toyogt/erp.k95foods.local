{
  "name": "StoreLot",
  "type": "object",
  "title": "Store Lot",
  "description": "Lot/Batch record created during Gate Entry with QR code for scanning",
  "properties": {
    "lot_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Auto-generated: LOT-YYYYMMDD-NNNN"
    },
    "qr_code": {
      "type": "string",
      "maxLength": 200,
      "description": "QR payload (same as lot_id)"
    },
    "item_code": {
      "type": "string",
      "maxLength": 100
    },
    "item_name": {
      "type": "string",
      "maxLength": 300
    },
    "uom": {
      "type": "string",
      "maxLength": 50
    },
    "quantity": {
      "type": "number",
      "minimum": 0,
      "description": "Original received quantity"
    },
    "remaining_quantity": {
      "type": "number",
      "minimum": 0,
      "description": "Current available quantity"
    },
    "mfg_date": {
      "type": "string",
      "format": "date"
    },
    "expiry_date": {
      "type": "string",
      "format": "date"
    },
    "week_number": {
      "type": "number",
      "description": "ISO week number from mfg_date (auto-calculated)"
    },
    "weeks_elapsed": {
      "type": "number",
      "description": "Weeks since manufacture (for aging color)"
    },
    "supplier_name": {
      "type": "string",
      "maxLength": 300
    },
    "grn_id": {
      "type": "string",
      "maxLength": 100
    },
    "gate_entry_id": {
      "type": "string",
      "maxLength": 100
    },
    "purchase_order_id": {
      "type": "string",
      "maxLength": 100
    },
    "status": {
      "type": "string",
      "enum": [
        "qc_pending",
        "approved",
        "rejected",
        "putaway",
        "consumed",
        "damaged"
      ],
      "default": "qc_pending"
    },
    "qc_notes": {
      "type": "string",
      "maxLength": 1000
    },
    "qc_by": {
      "type": "string",
      "maxLength": 200
    },
    "qc_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "lot_id",
    "item_code",
    "quantity"
  ]
}