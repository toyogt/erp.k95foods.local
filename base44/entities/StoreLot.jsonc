{
  "name": "StoreLot",
  "type": "object",
  "title": "Store Lot",
  "description": "Lot/Batch record created during Gate Entry with QR code for scanning",
  "properties": {
    "lot_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Auto-generated: LOT-YYYYMMDD-NNNN"
    },
    "qr_code": {
      "type": "string",
      "maxLength": 200,
      "description": "QR payload (same as lot_id)"
    },
    "item_code": {
      "type": "string",
      "maxLength": 100
    },
    "item_name": {
      "type": "string",
      "maxLength": 300
    },
    "uom": {
      "type": "string",
      "maxLength": 50
    },
    "original_quantity": {
      "type": "number",
      "minimum": 0,
      "description": "Original quantity as per invoice/PO before mismatch adjustment"
    },
    "quantity": {
      "type": "number",
      "minimum": 0,
      "description": "Actual received quantity (after mismatch adjustment)"
    },
    "remaining_quantity": {
      "type": "number",
      "minimum": 0,
      "description": "Current available quantity"
    },
    "mismatch_type": {
      "type": "string",
      "enum": [
        "none",
        "damaged",
        "decreased",
        "increased"
      ],
      "default": "none"
    },
    "mismatch_reason": {
      "type": "string",
      "maxLength": 500
    },
    "batch_number": {
      "type": "string",
      "maxLength": 200,
      "description": "Batch identifier for FIFO/FEFO grouping"
    },
    "supplier_lot_number": {
      "type": "string",
      "maxLength": 200,
      "description": "Supplier's own lot/batch reference number"
    },
    "mfg_date": {
      "type": "string",
      "format": "date"
    },
    "expiry_date": {
      "type": "string",
      "format": "date"
    },
    "week_number": {
      "type": "number",
      "description": "ISO week number from mfg_date (auto-calculated)"
    },
    "weeks_elapsed": {
      "type": "number",
      "description": "Weeks since manufacture (for aging color)"
    },
    "supplier_name": {
      "type": "string",
      "maxLength": 300
    },
    "invoice_number": {
      "type": "string",
      "maxLength": 100,
      "description": "Supplier invoice number from GRN header"
    },
    "invoice_date": {
      "type": "string",
      "format": "date",
      "description": "Supplier invoice date from GRN header"
    },
    "grn_id": {
      "type": "string",
      "maxLength": 100
    },
    "gate_entry_id": {
      "type": "string",
      "maxLength": 100
    },
    "purchase_order_id": {
      "type": "string",
      "maxLength": 100
    },
    "source_type": {
      "type": "string",
      "enum": [
        "grn",
        "opening_stock",
        "adjustment",
        "return"
      ],
      "default": "grn",
      "description": "How this lot was created"
    },
    "status": {
      "type": "string",
      "enum": [
        "approved",
        "rejected",
        "putaway",
        "consumed",
        "damaged",
        "quarantine"
      ],
      "default": "approved"
    },
    "qc_notes": {
      "type": "string",
      "maxLength": 1000
    },
    "qc_by": {
      "type": "string",
      "maxLength": 200
    },
    "qc_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "lot_id",
    "item_code",
    "quantity"
  ]
}