{
  "name": "ShiftSession",
  "type": "object",
  "title": "Shift Session",
  "properties": {
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "station_type": {
      "type": "string",
      "enum": [
        "FILLING",
        "LABELLING",
        "CHAMBER"
      ]
    },
    "machine_id": {
      "type": "string",
      "maxLength": 50
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "started_by": {
      "type": "string",
      "maxLength": 200
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_by": {
      "type": "string",
      "maxLength": 200
    },
    "shift_code": {
      "type": "string",
      "maxLength": 50
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "ENDED"
      ],
      "default": "ACTIVE"
    },
    "notes": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "session_id",
    "station_type",
    "machine_id"
  ]
}