{
  "name": "QCInspectionItem",
  "type": "object",
  "title": "QC Inspection Item",
  "properties": {
    "qc_id": {
      "type": "string",
      "maxLength": 50
    },
    "sku_code": {
      "type": "string",
      "maxLength": 100
    },
    "item_name": {
      "type": "string",
      "maxLength": 200
    },
    "grn_item_ref": {
      "type": "string",
      "maxLength": 100
    },
    "sample_qty": {
      "type": "number",
      "minimum": 0
    },
    "received_qty": {
      "type": "number",
      "minimum": 0
    },
    "result": {
      "type": "string",
      "enum": [
        "PASS",
        "HOLD",
        "FAIL"
      ]
    },
    "defect_notes": {
      "type": "string",
      "maxLength": 1000
    },
    "photos_json": {
      "type": "string",
      "maxLength": 5000
    }
  },
  "required": [
    "qc_id",
    "sku_code",
    "result"
  ]
}