{
  "name": "SupplierItemMapping",
  "type": "object",
  "title": "Supplier Item Mapping",
  "description": "Maps which supplier provides which item with rate history",
  "properties": {
    "supplier_id": {
      "type": "string",
      "maxLength": 100,
      "description": "Reference to Supplier.supplier_id"
    },
    "supplier_name": {
      "type": "string",
      "maxLength": 300
    },
    "item_id": {
      "type": "string",
      "maxLength": 100,
      "description": "Reference to StoreItemMaster record id"
    },
    "item_code": {
      "type": "string",
      "maxLength": 100
    },
    "item_name": {
      "type": "string",
      "maxLength": 300
    },
    "last_rate": {
      "type": "number",
      "minimum": 0,
      "description": "Last purchased rate from this supplier"
    },
    "is_preferred": {
      "type": "boolean",
      "default": false,
      "description": "Whether this supplier is preferred for this item"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "supplier_id",
    "item_name"
  ]
}