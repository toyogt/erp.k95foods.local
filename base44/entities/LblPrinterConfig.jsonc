{
  "name": "LblPrinterConfig",
  "type": "object",
  "title": "Labelling Printer Configuration",
  "properties": {
    "printer_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "line_id": {
      "type": "string",
      "maxLength": 100,
      "description": "Assigned labelling line"
    },
    "line_name": {
      "type": "string",
      "maxLength": 200
    },
    "api_endpoint": {
      "type": "string",
      "maxLength": 500
    },
    "connection_type": {
      "type": "string",
      "enum": [
        "api",
        "usb",
        "network",
        "manual"
      ],
      "default": "manual"
    },
    "ip_address": {
      "type": "string",
      "maxLength": 100
    },
    "port": {
      "type": "number"
    },
    "default_template": {
      "type": "string",
      "maxLength": 200,
      "description": "Default label template name"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "status": {
      "type": "string",
      "enum": [
        "online",
        "offline",
        "error",
        "idle"
      ],
      "default": "idle"
    },
    "notes": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "printer_id",
    "name"
  ]
}