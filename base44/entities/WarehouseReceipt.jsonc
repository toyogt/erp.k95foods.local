{
  "name": "WarehouseReceipt",
  "type": "object",
  "title": "Warehouse Receipt",
  "properties": {
    "receipt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "receipt_date": {
      "type": "string",
      "format": "date"
    },
    "received_by": {
      "type": "string",
      "maxLength": 200
    },
    "doc_number": {
      "type": "string",
      "maxLength": 100,
      "description": "Supplier DC / Internal doc number"
    },
    "doc_photo": {
      "type": "string",
      "maxLength": 500,
      "description": "URL of uploaded document photo"
    },
    "notes": {
      "type": "string",
      "maxLength": 1000
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "CONFIRMED"
      ],
      "default": "DRAFT"
    },
    "shift_session_id": {
      "type": "string",
      "maxLength": 100
    }
  },
  "required": [
    "receipt_id",
    "receipt_date"
  ]
}