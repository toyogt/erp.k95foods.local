{
  "name": "Department",
  "type": "object",
  "title": "Department",
  "description": "Master list of departments. Used to normalize Employee.department and to identify the department head for HR notifications (e.g. attendance anomalies).",
  "properties": {
    "department_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Unique department name (e.g. PRODUCTION, ACCOUNTS & FINANCE)"
    },
    "department_head_email": {
      "type": "string",
      "maxLength": 200,
      "description": "Email of the department head \u2014 used as supervisor recipient for attendance alerts"
    },
    "department_head_name": {
      "type": "string",
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "department_name"
  ]
}