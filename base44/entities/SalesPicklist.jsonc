{
  "name": "SalesPicklist",
  "type": "object",
  "properties": {
    "sales_order_id": {
      "type": "string",
      "title": "Sales Order ID"
    },
    "so_number": {
      "type": "string",
      "title": "Sales Order Number"
    },
    "picklist_number": {
      "type": "string",
      "title": "Picklist Number"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "dispatch_scheduled",
        "pick_packed",
        "cancelled"
      ],
      "title": "Status"
    },
    "dispatch_date": {
      "type": "string",
      "title": "Dispatch Date"
    },
    "appointment_date": {
      "type": "string",
      "title": "Appointment Date"
    },
    "expiry_date": {
      "type": "string",
      "title": "Expiry Date"
    },
    "transporter": {
      "type": "string",
      "title": "Transporter"
    },
    "packaging_type": {
      "type": "string",
      "title": "Packaging Type"
    },
    "generated_by": {
      "type": "string",
      "title": "Generated By"
    },
    "completed_by": {
      "type": "string",
      "title": "Completed By"
    },
    "completed_at": {
      "type": "string",
      "title": "Completed At"
    },
    "cancellation_reason": {
      "type": "string",
      "title": "Cancellation Reason"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "items": {
      "type": "array",
      "title": "Picklist Items",
      "items": {
        "type": "object",
        "properties": {
          "sales_order_item_id": {
            "type": "string"
          },
          "item_code": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "required_qty": {
            "type": "number"
          },
          "picked_qty": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "picked",
              "short"
            ]
          }
        }
      }
    }
  },
  "required": [
    "sales_order_id"
  ]
}