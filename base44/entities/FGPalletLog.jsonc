{
  "name": "FGPalletLog",
  "type": "object",
  "title": "FG Pallet Log",
  "properties": {
    "fg_pallet_id": {
      "type": "string",
      "maxLength": 50
    },
    "action": {
      "type": "string",
      "enum": [
        "CREATE",
        "ADD_CASES",
        "MOVE",
        "CLOSE"
      ]
    },
    "qty_cases": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "location": {
      "type": "string",
      "maxLength": 100
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "user": {
      "type": "string",
      "maxLength": 200
    },
    "wo_id": {
      "type": "string",
      "maxLength": 50
    }
  },
  "required": [
    "fg_pallet_id",
    "action"
  ]
}