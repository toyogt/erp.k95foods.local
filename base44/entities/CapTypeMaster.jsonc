{
  "name": "CapTypeMaster",
  "type": "object",
  "title": "Cap Type Master",
  "properties": {
    "cap_type_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Cap type name (e.g., Crown Cap, Flip-Top Cap)"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order in dropdowns"
    }
  },
  "required": [
    "cap_type_name"
  ]
}