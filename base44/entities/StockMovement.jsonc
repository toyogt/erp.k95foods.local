{
  "name": "StockMovement",
  "type": "object",
  "title": "Stock Movement",
  "properties": {
    "move_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "move_type": {
      "type": "string",
      "enum": [
        "GRN_IN",
        "QC_PASS_MOVE",
        "QC_HOLD_MOVE",
        "QC_FAIL_MOVE",
        "PUTAWAY",
        "TRANSFER",
        "ADJUSTMENT"
      ]
    },
    "reference_type": {
      "type": "string",
      "maxLength": 50
    },
    "reference_id": {
      "type": "string",
      "maxLength": 100
    },
    "sku_code": {
      "type": "string",
      "maxLength": 100
    },
    "qty": {
      "type": "number"
    },
    "from_bin_id": {
      "type": "string",
      "maxLength": 50
    },
    "to_bin_id": {
      "type": "string",
      "maxLength": 50
    },
    "performed_by": {
      "type": "string",
      "maxLength": 200
    },
    "notes": {
      "type": "string",
      "maxLength": 1000
    },
    "photos_json": {
      "type": "string",
      "maxLength": 2000
    }
  },
  "required": [
    "move_id",
    "move_type",
    "sku_code",
    "qty"
  ]
}