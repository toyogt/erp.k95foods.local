{
  "name": "DashboardWidget",
  "type": "object",
  "title": "Dashboard Widget",
  "properties": {
    "widget_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "maxLength": 300
    },
    "role_default_enabled": {
      "type": "boolean",
      "default": true
    },
    "query_type": {
      "type": "string",
      "enum": [
        "COUNT",
        "SUM",
        "LIST",
        "STATUS"
      ]
    },
    "data_source": {
      "type": "string",
      "enum": [
        "CRATE",
        "PALLET",
        "BATCH",
        "WO",
        "MOVEMENT_LOG",
        "SESSION",
        "OFFLINE_QUEUE",
        "ALERT"
      ]
    },
    "filter_json": {
      "type": "object"
    },
    "display_type": {
      "type": "string",
      "enum": [
        "BIG_NUMBER",
        "SMALL_CARD",
        "LIST"
      ]
    },
    "target_roles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "widget_key",
    "title",
    "query_type",
    "data_source",
    "display_type"
  ]
}