{
  "name": "WarehouseShiftSession",
  "type": "object",
  "title": "Warehouse Shift Session",
  "properties": {
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "shift_date": {
      "type": "string",
      "format": "date"
    },
    "shift_label": {
      "type": "string",
      "enum": [
        "MORNING",
        "AFTERNOON",
        "NIGHT"
      ],
      "default": "MORNING"
    },
    "started_by": {
      "type": "string",
      "maxLength": 200
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_by": {
      "type": "string",
      "maxLength": 200
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "handover_to": {
      "type": "string",
      "maxLength": 200
    },
    "handover_notes": {
      "type": "string",
      "maxLength": 2000
    },
    "checklist_stock_verified": {
      "type": "boolean"
    },
    "checklist_receipts_ok": {
      "type": "boolean"
    },
    "checklist_dispatches_ok": {
      "type": "boolean"
    },
    "checklist_trial_packs_ok": {
      "type": "boolean"
    },
    "checklist_floor_clean": {
      "type": "boolean"
    },
    "discrepancy_notes": {
      "type": "string",
      "maxLength": 1000
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "CLOSED"
      ],
      "default": "ACTIVE"
    }
  },
  "required": [
    "session_id",
    "shift_date"
  ]
}