{
  "name": "ShiftHandover",
  "type": "object",
  "title": "Shift Handover",
  "properties": {
    "handover_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "station_type": {
      "type": "string",
      "enum": [
        "FILLING",
        "LABELLING",
        "CHAMBER"
      ]
    },
    "machine_id": {
      "type": "string",
      "maxLength": 50
    },
    "from_user": {
      "type": "string",
      "maxLength": 200
    },
    "to_user": {
      "type": "string",
      "maxLength": 200
    },
    "handover_at": {
      "type": "string",
      "format": "date-time"
    },
    "checklist_run_id": {
      "type": "string",
      "maxLength": 100
    },
    "old_session_id": {
      "type": "string",
      "maxLength": 100
    },
    "new_session_id": {
      "type": "string",
      "maxLength": 100
    },
    "notes": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "handover_id",
    "station_type",
    "machine_id"
  ]
}