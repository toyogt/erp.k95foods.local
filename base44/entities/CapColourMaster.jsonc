{
  "name": "CapColourMaster",
  "type": "object",
  "title": "Cap Colour Master",
  "properties": {
    "colour_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Cap colour name (e.g., Gold, Silver, Red)"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order in dropdowns"
    }
  },
  "required": [
    "colour_name"
  ]
}