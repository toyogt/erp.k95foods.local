{
  "name": "StoreItemMaster",
  "type": "object",
  "title": "Store Item Master",
  "description": "Centralized item master with validation rules for Store operations",
  "properties": {
    "item_code": {
      "type": "string",
      "maxLength": 100,
      "description": "Auto-generated sequential code e.g. ITEM-0001"
    },
    "item_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "item_category": {
      "type": "string",
      "enum": [
        "ingredient",
        "box_type",
        "cap_type",
        "container",
        "flavour",
        "label_artwork",
        "packaging",
        "other"
      ],
      "default": "other"
    },
    "source_entity": {
      "type": "string",
      "maxLength": 100,
      "description": "Source entity type if imported from System master (e.g. IngredientItem, BoxType)"
    },
    "source_id": {
      "type": "string",
      "maxLength": 100,
      "description": "ID of the source record in the original entity"
    },
    "uom": {
      "type": "string",
      "maxLength": 50,
      "default": "Nos"
    },
    "material_photo": {
      "type": "string",
      "maxLength": 1000,
      "description": "URL of the uploaded material photo"
    },
    "batch_required": {
      "type": "boolean",
      "default": false,
      "description": "Is batch number mandatory for this item?"
    },
    "expiry_required": {
      "type": "boolean",
      "default": false,
      "description": "Is expiry date mandatory?"
    },
    "mfg_date_required": {
      "type": "boolean",
      "default": false,
      "description": "Is manufacture date mandatory?"
    },
    "qc_required": {
      "type": "boolean",
      "default": false,
      "description": "Does this item require QC inspection?"
    },
    "min_shelf_life_days": {
      "type": "number",
      "minimum": 0,
      "description": "Minimum required shelf life at time of receipt (days)"
    },
    "opening_stock": {
      "type": "number",
      "minimum": 0,
      "default": 0,
      "description": "Opening stock quantity for this item"
    },
    "reorder_level": {
      "type": "number",
      "minimum": 0,
      "default": 0,
      "description": "Reorder alert level for this item"
    },
    "storage_notes": {
      "type": "string",
      "maxLength": 500
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "item_name",
    "item_category"
  ]
}