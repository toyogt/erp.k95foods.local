{
  "name": "ZoneLock",
  "type": "object",
  "title": "Zone Lock",
  "properties": {
    "zone_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "product_code": {
      "type": "string",
      "maxLength": 100
    },
    "batch_id": {
      "type": "string",
      "maxLength": 50
    },
    "locked_at": {
      "type": "string",
      "format": "date-time"
    },
    "locked_by": {
      "type": "string",
      "maxLength": 200
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "zone_id"
  ]
}